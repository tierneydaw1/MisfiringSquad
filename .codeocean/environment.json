				},
				{
					"name": "ipykernel",
					"version": "7.3.0"
				},
				{
					"name": "matplotlib",
					"version": "3.11.1"
				},
				{
					"name": "numpy",
					"version": "2.5.2"
				},
				{
					"name": "pandas",
					"version": "3.0.5"
				},
				{
					"name": "pynwb[zarr]",
					"version": "4.0.0"
				},
				{
					"name": "scipy",
					"version": "1.18.1"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	}
