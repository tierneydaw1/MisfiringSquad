{
	"version": 1,
	"base_image": "codeocean/swdb:Python3.12code-server4.133bedrock-auth0.5.0",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"apt": {
			"packages": [
				{
					"name": "build-essential",
					"version": "12.9ubuntu3"
				}
			],
			"install_software_properties_common": true
		},
		"conda": {
			"packages": [
				{
					"name": "jupyterlab",
					"version": "4.6.3"
				}
			]
		},
		"pip": {
			"packages": [
				{
					"name": "aind-data-access-api",
